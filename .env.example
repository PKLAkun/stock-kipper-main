# ============================================================
# CONTOH KONFIGURASI (salin ke .env.local). JANGAN commit .env.local.
# Aplikasi memakai Supabase (PostgreSQL + Realtime) untuk development DAN production.
# ============================================================

# Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL= https://__.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= sb_publishable_
# SERVICE ROLE: rahasia, hanya server. Jangan pakai awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY= sb_secret_

# Secret token sesi (min. 32 karakter): openssl rand -base64 32
AUTH_SECRET= /*run this code for get auth-secret node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" */
AUTH_SESSION_HOURS=8
AUTH_SESSION_IDLE_MINUTES=45

# Data awal (`npm run seed`). Isi di .env.local, jangan commit.
# Superadmin 1 memakai ADMIN_*. Nama (_NAME) boleh dikosongkan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_SUPERADMIN2_NAME=
SEED_SUPERADMIN2_EMAIL=
SEED_SUPERADMIN2_PASSWORD=
# DE (role admin)
SEED_DE_NAME=
SEED_DE_EMAIL=
SEED_DE_PASSWORD=
# SK (role staff)
SEED_SK1_NAME=
SEED_SK1_EMAIL=
SEED_SK1_PASSWORD=
SEED_SK2_NAME=
SEED_SK2_EMAIL=
SEED_SK2_PASSWORD=
# Operator: nama dan PIN (4 sampai 8 angka)
SEED_OPERATOR1_NAME=
SEED_OPERATOR1_PIN=
SEED_OPERATOR2_NAME=
SEED_OPERATOR2_PIN=
